PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusmate
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
AI_WORKFLOW_URL=http://127.0.0.1:8010
# Optional: Gmail address and app password for OTP and invite emails
EMAIL_USER=
EMAIL_PASS=
# Optional: separate n8n workflow webhook
N8N_WEBHOOK_URL=
