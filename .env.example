# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by Git; this template is committed.

# --- Application ---
APP_NAME=CampusMate AI
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Use the dedicated low-privilege role (see backend/scripts/create_local_db.sql),
# never the "postgres" superuser.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusmate
DB_USER=campusmate_app
DB_PASSWORD=change-me
# Docker only (compose.yaml): the PostgreSQL superuser's password, used once to create the role above.
# POSTGRES_PASSWORD=change-me-too

# --- Login sessions ---
SESSION_TTL_HOURS=12
# true in production (HTTPS only; required when APP_ENV=production); false for local http://127.0.0.1
COOKIE_SECURE=false

# --- Abuse limits (counted in PostgreSQL) ---
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_WINDOW_MINUTES=15
# CHAT_QUESTIONS_PER_MINUTE=20
# MAX_BODY_KB=64

# --- Uploads ---
MAX_UPLOAD_MB=50

# --- Ingestion ---
CHUNK_MAX_CHARS=1200
INGESTION_LEASE_MINUTES=30
WORKER_POLL_SECONDS=5
# The API ingests uploads in a background thread (only one process may use the embedded vector store)
# INGESTION_IN_API=true

# --- Retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_TOP_K=8
# Leave empty: the embedded vector store. A Chroma server is possible, but chromadb's server has an
# UNFIXED pre-authentication remote-code-execution flaw (CVE-2026-45829): never make it reachable.
# CHROMA_URL=
# opt-in reranking (search mode hybrid_rerank)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANK_CANDIDATES=30

# --- Answer generation ---
# extractive (no model; default) | openai_compatible (Ollama, llama.cpp server, LM Studio, or a hosted API)
GENERATION_PROVIDER=extractive
# Ollama's default local address. A non-local URL sends questions and evidence off this machine.
# GENERATION_BASE_URL=http://127.0.0.1:11434/v1
# The name the server knows the model by (required for openai_compatible)
# GENERATION_MODEL=
# Only for hosted APIs. Never commit a real key.
# GENERATION_API_KEY=
# GENERATION_TIMEOUT_SECONDS=120
# GENERATION_MAX_TOKENS=400
# GENERATION_TEMPERATURE=0

# --- Local folders (optional; defaults shown, relative to the repo root) ---
# DATA_DIR=data
# STORAGE_DIR=storage
# MODEL_CACHE_DIR=model_cache
